# ---------- Hardy RMM configuration ----------

# Public URL users and agents reach (must be HTTPS in production)
PUBLIC_URL=https://remote.hardyvpn.online
COMPANY_NAME=Hardy RMM

# Where docker publishes the web port. Keep 127.0.0.1 when a reverse proxy
# on the same host fronts it; use 0.0.0.0:8080 to expose it directly.
HARDY_BIND=127.0.0.1:8080
# Only used with `--profile caddy`
HARDY_DOMAIN=remote.hardyvpn.online

# Postgres
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# ---------- Authentik SSO (OIDC) ----------
# Issuer = https://<your-authentik>/application/o/<application-slug>/
OIDC_ISSUER=https://auth.example.com/application/o/hardy-rmm/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Authentik group names -> RMM roles (comma separated)
OIDC_ADMIN_GROUPS=RMM Admins
OIDC_TECH_GROUPS=RMM Technicians
OIDC_VIEWER_GROUPS=RMM Viewers
# Role for users in none of the groups: admin | technician | viewer | (empty = deny)
OIDC_DEFAULT_ROLE=

# ---------- Break-glass local admin (optional) ----------
# Lets you sign in if Authentik is down. Leave the password empty to disable.
LOCAL_ADMIN_EMAIL=admin@hardyvpn.online
LOCAL_ADMIN_PASSWORD=

# ---------- RustDesk backup remote access ----------
# Hostname (or IP) of this server as reached by devices on ports 21115-21119.
# If you use Cloudflare, make this a DNS-only (grey cloud) record.
RUSTDESK_HOST=rustdesk.hardyvpn.online
# RUSTDESK_RELAY defaults to RUSTDESK_HOST
# RUSTDESK_KEY is read automatically from the hbbs volume

# ---------- Misc ----------
METRICS_RETENTION_DAYS=14
SESSION_HOURS=12
TRUST_PROXY=true
TZ=America/Denver
