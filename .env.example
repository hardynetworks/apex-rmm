# ---------- Apex RMM: optional overrides ----------
#
# You do NOT need this file. Run `docker compose up -d --build`, open
# http://<server>:8080 and the setup wizard walks you through everything.
# Public URL, Authentik SSO and RustDesk are then edited under Settings.
#
# Copy to .env only if you want to pin a value. Anything set here overrides
# the dashboard and shows as locked in Settings.

# Port (or ip:port) the dashboard is published on. Use 127.0.0.1:8080 when a
# reverse proxy on the same host fronts it.
# APEX_BIND=8080

# Hostname for the optional Caddy reverse proxy (`--profile caddy`).
# APEX_DOMAIN=rmm.example.com

# ---------- Settings you can also edit in the dashboard ----------
# PUBLIC_URL=https://rmm.example.com
# COMPANY_NAME=Apex RMM

# OIDC_ISSUER=https://auth.example.com/application/o/apex-rmm/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_ADMIN_GROUPS=RMM Admins
# OIDC_TECH_GROUPS=RMM Technicians
# OIDC_VIEWER_GROUPS=RMM Viewers
# OIDC_DEFAULT_ROLE=

# RUSTDESK_HOST=rustdesk.example.com
# RUSTDESK_RELAY=
# RUSTDESK_KEY=

# ---------- Environment-only ----------
# Break-glass admin that always works (in addition to accounts made in the wizard).
# LOCAL_ADMIN_EMAIL=admin@example.com
# LOCAL_ADMIN_PASSWORD=

# METRICS_RETENTION_DAYS=14
# SESSION_HOURS=12
# TRUST_PROXY=true
# TZ=America/Denver
